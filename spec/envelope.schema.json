{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Krow-labs/krowmail/spec/envelope.schema.json",
  "title": "KrowmailEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "from", "to", "body", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "from": { "type": "string", "minLength": 3 },
    "to": { "type": "string", "minLength": 3 },
    "subject": { "type": "string" },
    "body": { "type": "string" },
    "thread_id": { "type": ["string", "null"] },
    "in_reply_to": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "href": { "type": "string" }
        }
      }
    },
    "participants": {
      "description": "在场者（主收件人 + 抄送），最多 1 + 5 人。缺省 = 单收件人。每位抄送各收到一份独立签名的信封。",
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/participant" }
    },
    "mentions": {
      "description": "正文里 @地址 抽出的卡片，只暴露给读信端，不投递。",
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/participant" }
    },
    "cc": {
      "description": "这一份是抄送副本（收件人不是主收件人）。缺省 false。",
      "type": "boolean"
    },
    "kind": {
      "description": "协议位（0.3.0）。缺省 = 普通信。ack / close 是不期待回复的确认与收尾；request 是要对方给出结局的请求（可带 due_at）；decision 是对某个 request 的结局（必带 decision_for 与 outcome）。收件方不认识这些值时按普通信处理即可。",
      "type": "string",
      "enum": ["ack", "close", "request", "decision"]
    },
    "due_at": {
      "description": "仅 kind=request：请求方期望收到结局的时刻（RFC 3339）。只是期望，不是对收件方的强制；收件方实现可以据此提醒或到期判定。",
      "type": "string",
      "minLength": 1
    },
    "decision_for": {
      "description": "仅 kind=decision：被收尾的那封 request 信封的 id。",
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "description": "仅 kind=decision：结局。done 办了 / declined 明确拒绝 / needs_info 缺材料（请求方补齐后另发新请求）/ expired 到期未处理（由请求方或收件方的服务器判定）/ withdrawn 请求方撤回。",
      "type": "string",
      "enum": ["done", "declined", "needs_info", "expired", "withdrawn"]
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address"],
      "properties": {
        "address": { "type": "string", "minLength": 3, "description": "完整的开放地址（带 @域名）。" },
        "name": { "type": "string", "description": "展示名，可空。" },
        "role": { "type": "string", "enum": ["to", "cc", ""], "description": "to = 主收件人，cc = 抄送；提及卡片留空。" }
      }
    }
  }
}
