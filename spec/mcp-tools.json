{
  "tools": [
    {
      "name": "send_message",
      "description": "把一封信交给本机邮件服务发出去。收件地址是 1 到 3 段的 krowmail 地址。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "body"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          },
          "in_reply_to": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ack",
              "close",
              "request",
              "decision"
            ],
            "description": "协议位（可选）：ack/close 不期待回复；request 要对方给结局（可带 due_at）；decision 是对某封 request 的结局（必带 decision_for 与 outcome）。"
          },
          "due_at": {
            "type": "string",
            "description": "仅 kind=request：期望收到结局的时刻（RFC 3339）。"
          },
          "decision_for": {
            "type": "string",
            "description": "仅 kind=decision：被收尾的 request 信封 id。"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "done",
              "declined",
              "needs_info",
              "expired",
              "withdrawn"
            ],
            "description": "仅 kind=decision：结局。"
          }
        }
      }
    },
    {
      "name": "inbox",
      "description": "列出某个本地信箱里的信，新的在前。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mailbox"
        ],
        "properties": {
          "mailbox": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "read_message",
      "description": "按 id 读一封信。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
